<%- include('partials/header') %>

  <main class="flex-grow flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-[520px] space-y-8">
      <div class="text-center">
        <h1 class="text-[#0d141b] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em] mb-3">
          Commence à écrire Aujourd'hui
        </h1>
        <p class="text-[#4c739a] dark:text-slate-400 text-lg font-normal leading-normal">
          Join nous pour exprimer tes idées.
        </p>
      </div>
      <div
        class="bg-white dark:bg-slate-900 shadow-sm rounded-xl border border-[#e7edf3] dark:border-slate-800 p-8 sm:p-10">
        <%- include('partials/messages') %>
        <form class="space-y-6" action="register" method="POST">
          <div class="flex flex-col gap-2">
            <label class="text-[#0d141b] dark:text-slate-200 text-base font-medium leading-normal"
              for="username">Prénoms</label>
            <input
              class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#0d141b] dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/20 border border-[#cfdbe7] dark:border-slate-700 bg-[#f8fafc] dark:bg-slate-800 focus:border-primary h-14 placeholder:text-[#4c739a] dark:placeholder:text-slate-500 p-[15px] text-base font-normal leading-normal transition-all"
              id="username" name="username" placeholder="Paul" type="text" value="" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-[#0d141b] dark:text-slate-200 text-base font-medium leading-normal"
              for="password">Mot de passe</label>
            <div class="relative flex w-full items-stretch rounded-lg">
              <input
                class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#0d141b] dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/20 border border-[#cfdbe7] dark:border-slate-700 bg-[#f8fafc] dark:bg-slate-800 focus:border-primary h-14 placeholder:text-[#4c739a] dark:placeholder:text-slate-500 p-[15px] pr-12 text-base font-normal leading-normal transition-all"
                id="password" name="password" placeholder="Créer un mot de passe" type="password" value="" />
              <button
                class="absolute right-0 top-0 bottom-0 px-4 flex items-center justify-center text-[#4c739a] dark:text-slate-500 hover:text-[#0d141b] dark:hover:text-white transition-colors"
                type="button">
                <span class="material-symbols-outlined">visibility_off</span>
              </button>
            </div>
          </div>
          <div class="pt-2">
            <button
              type="submit"
              class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-lg h-14 px-5 bg-primary hover:bg-blue-600 text-white text-lg font-bold leading-normal tracking-[0.015em] transition-all shadow-sm hover:shadow-md focus:ring-2 focus:ring-offset-2 focus:ring-primary dark:focus:ring-offset-slate-900">
              Creer un Compte
            </button>
          </div>
        </form>
        <div class="relative flex py-2 items-center my-6">
          <div class="flex-grow border-t border-[#cfdbe7] dark:border-slate-700"></div>
          <span class="flex-shrink-0 mx-4 text-sm text-[#4c739a] dark:text-slate-500 font-medium">OR</span>
          <div class="flex-grow border-t border-[#cfdbe7] dark:border-slate-700"></div>
        </div>
        <button
          class="flex w-full cursor-pointer items-center justify-center gap-3 overflow-hidden rounded-lg h-14 px-5 bg-white dark:bg-slate-800 text-[#0d141b] dark:text-white border border-[#cfdbe7] dark:border-slate-700 hover:bg-[#f8fafc] dark:hover:bg-slate-700 transition-all">
          <svg class="w-6 h-6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M23.52 12.273c0-.85-.076-1.668-.218-2.455H12v4.642h6.456c-.278 1.498-1.124 2.768-2.396 3.618v3.006h3.878c2.268-2.088 3.58-5.16 3.58-8.811z"
              fill="#4285F4"></path>
            <path
              d="M12 24c3.24 0 5.957-1.074 7.942-2.909l-3.878-3.006c-1.074.72-2.448 1.146-4.064 1.146-3.126 0-5.772-2.112-6.72-4.95H1.282v3.114C3.256 21.324 7.332 24 12 24z"
              fill="#34A853"></path>
            <path
              d="M5.28 14.28A7.26 7.26 0 0 1 4.909 12c0-.792.138-1.542.371-2.28V6.606H1.282A11.956 11.956 0 0 0 0 12c0 1.932.462 3.75 1.282 5.394l3.998-3.114z"
              fill="#FBBC05"></path>
            <path
              d="M12 4.752c1.764 0 3.348.606 4.59 1.794l3.444-3.444C17.952 1.176 15.234 0 12 0 7.332 0 3.256 2.676 1.282 6.606l3.998 3.114C6.228 6.864 8.874 4.752 12 4.752z"
              fill="#EA4335"></path>
          </svg>
          <span class="text-base font-bold leading-normal">Sign up with Google</span>
        </button>
        <div class="mt-8 text-center">
          <p class="text-[#4c739a] dark:text-slate-400 text-base font-normal">
            Already have an account?
            <a class="text-primary hover:text-blue-700 dark:hover:text-blue-400 font-bold ml-1 transition-colors underline-offset-4 hover:underline"
              href="#">Log in</a>
          </p>
        </div>
      </div>
    </div>
  </main>
  <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] rounded-full bg-primary/5 blur-[120px]"></div>
    <div
      class="absolute top-[40%] -left-[10%] w-[40%] h-[40%] rounded-full bg-blue-300/5 dark:bg-blue-900/10 blur-[100px]">
    </div>
  </div>
</body>

</html>


<!-- include footer page -->

<%- include('partials/footer') %>
