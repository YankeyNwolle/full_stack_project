<!DOCTYPE html>
<html class="light" lang="fr">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Mon Journal Quotidien</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Noto+Sans:wght@400;500;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link rel="icon" href="/img/logo/logo_full_stack.png" type="image/png" />
</head>
<body
  class="bg-background-light dark:bg-background-dark font-display text-[#0d141b] dark:text-white overflow-x-hidden min-h-screen flex flex-col">
    <nav class="w-full bg-white dark:bg-[#1a2632] border-b border-[#e7edf3] dark:border-slate-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3 text-[#0d141b] dark:text-white shrink-0">
                    <div class="flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-3xl">auto_stories</span>
                    </div>
                    <h2 class="text-xl font-bold leading-tight tracking-tight hidden sm:block">Mon Journal Quotidien
                    </h2>
                </div>
                <div
                    class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300 font-sans">
                    <a class="hover:text-primary transition-colors" href="/">Accueil</a> 
                    <a class="hover:text-primary transition-colors" href="#">À propos</a>
                    
                    <% if (isAuthenticated && user) { %>
                        <a href="/articles/create"
                            class="flex items-center justify-center overflow-hidden rounded-lg h-9 px-4 bg-primary hover:bg-blue-600 transition-colors text-white text-sm font-bold leading-normal tracking-[0.015em] shadow-sm">
                            <span class="mr-2 material-symbols-outlined text-[18px]">add</span>
                            <span class="truncate">Créer un article</span>
                        </a>
                        
                        <!-- PROFIL UTILISATEUR -->
                        <div class="relative">
                            <button 
                                onclick="toggleDropdown()" 
                                class="flex items-center gap-2 p-1.5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 transition"
                            >
                                <img 
                                    src="<%= user.avatar || '/img/default-avatar.png' %>" 
                                    alt="Avatar" 
                                    class="w-8 h-8 rounded-full object-cover border-2 border-slate-200 dark:border-slate-600"
                                />
                                <span class="hidden lg:block text-slate-700 dark:text-slate-200 font-medium"><%= user.name %></span>
                                <span class="material-symbols-outlined text-slate-500 text-[18px]">expand_more</span>
                            </button>
                            
                            <div 
                                id="userDropdown" 
                                class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-[#1a2632] rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 py-2 z-50"
                            >
                                <!-- Info utilisateur -->
                                <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700">
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white"><%= user.name %></p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 truncate"><%= user.email %></p>
                                </div>
                                
                                <!-- Liens du menu -->
                                <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                    <span class="material-symbols-outlined text-[20px] text-slate-400">person</span>
                                    Mon Profil
                                </a>
                                
                                <a href="/mes-articles" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                    <span class="material-symbols-outlined text-[20px] text-slate-400">article</span>
                                    Mes Articles
                                </a>
                                
                                <a href="/settings" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                    <span class="material-symbols-outlined text-[20px] text-slate-400">settings</span>
                                    Paramètres
                                </a>
                                
                                <!-- Déconnexion -->
                                <div class="border-t border-slate-100 dark:border-slate-700 mt-2 pt-2">
                                    <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition">
                                        <span class="material-symbols-outlined text-[20px]">logout</span>
                                        Déconnexion
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- BOUTONS CONNEXION / INSCRIPTION -->
                        <a class="hover:text-primary transition-colors" href="/register">S'inscrire</a>
                        <a class="hover:text-primary transition-colors" href="/login">Connexion</a>
                        <button
                            class="flex items-center justify-center overflow-hidden rounded-lg h-9 px-4 bg-primary hover:bg-blue-600 transition-colors text-white text-sm font-bold leading-normal tracking-[0.015em] shadow-sm ml-2"
                            onclick="window.location.href='/login'">
                            <span class="mr-2 material-symbols-outlined text-[18px]">add</span>
                            <span class="truncate">Créer un article</span>
                        </button>
                    <% } %>
                </div>
                
                <!-- MENU MOBILE -->
                <div class="md:hidden flex items-center">
                    <button
                        onclick="toggleMobileMenu()"
                        class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- MENU MOBILE DÉROULANT -->
        <div id="mobileMenu" class="hidden md:hidden bg-white dark:bg-[#1a2632] border-t border-slate-200 dark:border-slate-700 px-4 py-4">
            <div class="flex flex-col gap-3 text-sm font-medium text-slate-600 dark:text-slate-300">
                <a class="hover:text-primary transition-colors py-2" href="/">Accueil</a>
                <a class="hover:text-primary transition-colors py-2" href="#">À propos</a>
                
                <% if (isAuthenticated && user) { %>
                    <div class="flex items-center gap-3 py-2 border-t border-slate-100 dark:border-slate-700 mt-2 pt-4">
                        <img 
                            src="<%= user.avatar || '/img/default-avatar.png' %>" 
                            alt="Avatar" 
                            class="w-10 h-10 rounded-full object-cover border-2 border-slate-200"
                        />
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-white"><%= user.name %></p>
                            <p class="text-xs text-slate-500"><%= user.email %></p>
                        </div>
                    </div>
                    <a class="hover:text-primary transition-colors py-2" href="/profile">Mon Profil</a>
                    <a class="hover:text-primary transition-colors py-2" href="/mes-articles">Mes Articles</a>
                    <a class="hover:text-primary transition-colors py-2" href="/settings">Paramètres</a>
                    <a href="/articles/create"
                        class="flex items-center justify-center rounded-lg h-10 px-4 bg-primary hover:bg-blue-600 transition-colors text-white text-sm font-bold mt-2">
                        <span class="mr-2 material-symbols-outlined text-[18px]">add</span>
                        Créer un article
                    </a>
                    <a class="text-red-600 hover:text-red-700 transition-colors py-2 mt-2" href="/logout">Déconnexion</a>
                <% } else { %>
                    <a class="hover:text-primary transition-colors py-2" href="/register">S'inscrire</a>
                    <a class="hover:text-primary transition-colors py-2" href="/login">Connexion</a>
                    <button
                        onclick="window.location.href='/login'"
                        class="flex items-center justify-center rounded-lg h-10 px-4 bg-primary hover:bg-blue-600 transition-colors text-white text-sm font-bold mt-2">
                        <span class="mr-2 material-symbols-outlined text-[18px]">add</span>
                        Créer un article
                    </button>
                <% } %>
            </div>
        </div>
    </nav>
  
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#137fec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                    },
                    fontFamily: {
                        "display": ["Newsreader", "serif"],
                        "sans": ["Noto Sans", "sans-serif"],
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    